# Variables de entorno para El Rincón de Gredos
# Copia este archivo como .env.local para desarrollo, y añade estas variables
# en Vercel (Project Settings -> Environment Variables) para producción.
# NUNCA subas las claves reales al repositorio.

# --- Base de datos (Neon / Vercel Postgres) ---
# Se crea en Vercel: Storage -> Create Database -> Neon (Postgres).
# Vercel inyecta esta variable automáticamente al conectar la base al proyecto.
DATABASE_URL=

# --- Stripe ---
# Panel de Stripe -> Developers -> API keys (empieza con las claves de PRUEBA "test").
STRIPE_SECRET_KEY=

# Panel de Stripe -> Developers -> Webhooks -> endpoint /api/webhook -> "Signing secret".
STRIPE_WEBHOOK_SECRET=
